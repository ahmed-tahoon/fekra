# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical production URL — used by metadata, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL="https://www.fekra.com"

# ─── Email / Forms (sections 6, 8, 10, 16) ───────────────────────────────────
# Resend API key for contact + careers notifications.
RESEND_API_KEY=""
# Where form submissions are delivered.
CONTACT_INBOX="hello@fekra.com"
CAREERS_INBOX="careers@fekra.com"
# Verified sender (must be a domain verified in Resend).
EMAIL_FROM="Fekra Website <no-reply@fekra.com>"

# ─── Spam protection (16.2) ──────────────────────────────────────────────────
# Cloudflare Turnstile (optional but recommended). Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Booking (10.6) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=""

# ─── Analytics (section 17) ──────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""          # GA4 Measurement ID, e.g. G-XXXXXXX
NEXT_PUBLIC_GTM_ID=""         # Google Tag Manager, e.g. GTM-XXXXXX
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""
