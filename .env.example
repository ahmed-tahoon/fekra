##
## FEKRA website — environment contract (checklist 3.5 / 3.6)
## Copy to .env.local for development. Never commit real values.
##

# ---- Core ---------------------------------------------------------------
# Public origin, no trailing slash. Drives canonical URLs, sitemap, OG, CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production | staging | development — anything but "production" forces noindex.
NEXT_PUBLIC_ENV=development

# ---- Database -----------------------------------------------------------
# Postgres connection string (Neon/Supabase/RDS). Use the pooled URL on Vercel.
DATABASE_URL=postgres://user:password@localhost:5432/fekra

# ---- Payload ------------------------------------------------------------
# 32+ random chars. Rotating this invalidates every admin session.
PAYLOAD_SECRET=
# Shared secret for draft preview links (/api/preview).
PREVIEW_SECRET=

# ---- Seeding ------------------------------------------------------------
# `pnpm seed` is idempotent. Against a NON-local DATABASE_URL it refuses to run
# with the default password, so pass your own:
#   SEED_ADMIN_EMAIL=you@fekra-egy.com SEED_ADMIN_PASSWORD='...' pnpm seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# "false" skips the sample articles and example job — use it on a real database.
SEED_DEMO_CONTENT=true

# ---- Media & CV storage (S3 / Cloudflare R2) ----------------------------
# Leave S3_BUCKET empty to fall back to local disk in development.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2/MinIO only. Omit for AWS S3.
S3_ENDPOINT=
# Public hostname serving media, added to next/image remotePatterns.
S3_PUBLIC_HOST=

# ---- Email (Resend) -----------------------------------------------------
# Without a key, form submissions still save but no notification is sent.
RESEND_API_KEY=
EMAIL_FROM=website@fekra-egy.com

# ---- Holding page -------------------------------------------------------
# "true" serves /coming-soon for every PUBLIC route. /admin, /cms-api and /api
# keep working, so editors can load content behind the holding page.
# Unset or anything else = the real site. Set this in Vercel too, not just here.
COMING_SOON=false

# ---- Security -----------------------------------------------------------
# Set to true only after the third-party script inventory is verified on staging.
CSP_ENFORCE=false
